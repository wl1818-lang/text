<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>免部署在线代码编辑器</title>
    <!-- Ace Editor CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.4.14/ace.js">
    </script>
    <style>
        /* ===== 全局重置 & 字体 ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', 'PingFang SC', Roboto, 'Helvetica Neue', sans-serif;
            background: #1e1e2f;
            color: #e0e0e0;
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* ===== 顶部栏 ===== */
        .toolbar {
            background: linear-gradient(135deg, #2d2d44, #1a1a2e);
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            border-bottom: 1px solid #3a3a5a;
            flex-wrap: wrap;
            gap: 10px;
        }
        .toolbar .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 20px;
            font-weight: 700;
            color: #f0f0ff;
            letter-spacing: 0.5px;
        }
        .toolbar .brand .logo {
            font-size: 26px;
        }
        .toolbar .brand .badge {
            font-size: 12px;
            background: #6c5ce7;
            color: #fff;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 400;
            letter-spacing: 0.3px;
        }
        .toolbar .actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .toolbar .actions button {
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #d0d0e8;
            padding: 7px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 6px;
            backdrop-filter: blur(4px);
        }
        .toolbar .actions button:hover {
            background: rgba(108, 92, 231, 0.35);
            border-color: #6c5ce7;
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.25);
        }
        .toolbar .actions button:active {
            transform: scale(0.96);
        }
        .toolbar .actions button.primary {
            background: #6c5ce7;
            border-color: #6c5ce7;
            color: #fff;
        }
        .toolbar .actions button.primary:hover {
            background: #7c6df0;
            border-color: #7c6df0;
        }
        .toolbar .actions .theme-toggle {
            background: rgba(255, 255, 255, 0.05);
            font-size: 18px;
            padding: 7px 14px;
        }

        /* ===== 主体区域 ===== */
        .main {
            display: flex;
            flex: 1;
            min-height: 0;
            position: relative;
        }

        /* ===== 左侧编辑器 ===== */
        .editor-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            background: #1a1a2e;
            border-right: 1px solid #2d2d4a;
        }
        .editor-panel .tabs {
            display: flex;
            background: #16162a;
            padding: 0 12px;
            flex-shrink: 0;
            border-bottom: 1px solid #2d2d4a;
            gap: 2px;
        }
        .editor-panel .tabs .tab {
            padding: 10px 20px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            color: #8888aa;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            user-select: none;
            border-radius: 6px 6px 0 0;
            background: transparent;
        }
        .editor-panel .tabs .tab:hover {
            color: #d0d0f0;
            background: rgba(255, 255, 255, 0.04);
        }
        .editor-panel .tabs .tab.active {
            color: #f0f0ff;
            border-bottom-color: #6c5ce7;
            background: rgba(108, 92, 231, 0.10);
        }
        .editor-panel .tabs .tab .icon {
            margin-right: 6px;
            font-size: 15px;
        }
        .editor-panel .tabs .tab .lang-label {
            font-size: 12px;
            opacity: 0.7;
            margin-left: 4px;
            font-weight: 400;
        }
        #editor-container {
            flex: 1;
            min-height: 0;
            position: relative;
        }
        #editor-container .ace_editor {
            width: 100% !important;
            height: 100% !important;
        }

        /* ===== 右侧预览面板 ===== */
        .preview-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            background: #0f0f1a;
        }
        .preview-panel .preview-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 16px;
            background: #16162a;
            border-bottom: 1px solid #2d2d4a;
            flex-shrink: 0;
            font-size: 13px;
            color: #8888aa;
        }
        .preview-panel .preview-header .preview-title {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .preview-panel .preview-header .preview-title .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            background: #4ade80;
            box-shadow: 0 0 8px rgba(74, 222, 128, 0.4);
            transition: all 0.3s ease;
        }
        .preview-panel .preview-header .preview-title .dot.error {
            background: #f87171;
            box-shadow: 0 0 8px rgba(248, 113, 113, 0.4);
        }
        .preview-panel .preview-header .preview-actions {
            display: flex;
            gap: 8px;
        }
        .preview-panel .preview-header .preview-actions button {
            background: transparent;
            border: none;
            color: #8888aa;
            cursor: pointer;
            font-size: 16px;
            padding: 2px 8px;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .preview-panel .preview-header .preview-actions button:hover {
            color: #f0f0ff;
            background: rgba(255, 255, 255, 0.06);
        }
        #preview-frame {
            flex: 1;
            width: 100%;
            border: none;
            background: #ffffff;
            min-height: 0;
        }

        /* ===== 底部状态栏 ===== */
        .statusbar {
            background: #16162a;
            padding: 4px 20px;
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #6a6a8a;
            border-top: 1px solid #2d2d4a;
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 4px 16px;
        }
        .statusbar .status-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .statusbar .status-item .sep {
            color: #3a3a5a;
            margin: 0 4px;
        }

        /* ===== 亮色主题（覆盖） ===== */
        body.light-theme {
            background: #f0f0f5;
            color: #1a1a2e;
        }
        body.light-theme .toolbar {
            background: linear-gradient(135deg, #ffffff, #f0f0f5);
            border-bottom: 1px solid #d0d0dd;
        }
        body.light-theme .toolbar .brand {
            color: #1a1a2e;
        }
        body.light-theme .toolbar .brand .badge {
            background: #6c5ce7;
            color: #fff;
        }
        body.light-theme .toolbar .actions button {
            background: rgba(0, 0, 0, 0.04);
            border-color: rgba(0, 0, 0, 0.10);
            color: #3a3a5a;
        }
        body.light-theme .toolbar .actions button:hover {
            background: rgba(108, 92, 231, 0.15);
            border-color: #6c5ce7;
            color: #1a1a2e;
        }
        body.light-theme .toolbar .actions button.primary {
            background: #6c5ce7;
            border-color: #6c5ce7;
            color: #fff;
        }
        body.light-theme .editor-panel {
            background: #f8f8fc;
            border-right-color: #d0d0dd;
        }
        body.light-theme .editor-panel .tabs {
            background: #f0f0f5;
            border-bottom-color: #d0d0dd;
        }
        body.light-theme .editor-panel .tabs .tab {
            color: #6a6a8a;
        }
        body.light-theme .editor-panel .tabs .tab:hover {
            color: #1a1a2e;
            background: rgba(0, 0, 0, 0.03);
        }
        body.light-theme .editor-panel .tabs .tab.active {
            color: #1a1a2e;
            border-bottom-color: #6c5ce7;
            background: rgba(108, 92, 231, 0.08);
        }
        body.light-theme .preview-panel {
            background: #ffffff;
        }
        body.light-theme .preview-panel .preview-header {
            background: #f0f0f5;
            border-bottom-color: #d0d0dd;
            color: #6a6a8a;
        }
        body.light-theme .preview-panel .preview-header .preview-title .dot {
            background: #22c55e;
        }
        body.light-theme .preview-panel .preview-header .preview-actions button {
            color: #6a6a8a;
        }
        body.light-theme .preview-panel .preview-header .preview-actions button:hover {
            color: #1a1a2e;
            background: rgba(0, 0, 0, 0.04);
        }
        body.light-theme .statusbar {
            background: #f0f0f5;
            border-top-color: #d0d0dd;
            color: #8a8aaa;
        }
        body.light-theme .statusbar .status-item .sep {
            color: #d0d0dd;
        }
        body.light-theme #preview-frame {
            background: #ffffff;
        }
        /* Ace 编辑器主题由 JS 控制，亮色用 github，暗色用 monokai */

        /* ===== 响应式 ===== */
        @media (max-width: 820px) {
            .main {
                flex-direction: column;
            }
            .editor-panel {
                border-right: none;
                border-bottom: 1px solid #2d2d4a;
                flex: 1 1 50%;
            }
            .preview-panel {
                flex: 1 1 50%;
            }
            .toolbar {
                padding: 10px 16px;
            }
            .toolbar .brand {
                font-size: 17px;
            }
            .toolbar .actions button {
                padding: 5px 12px;
                font-size: 13px;
            }
            .editor-panel .tabs .tab {
                padding: 8px 14px;
                font-size: 13px;
            }
        }
        @media (max-width: 480px) {
            .toolbar .brand .badge {
                display: none;
            }
            .toolbar .actions button span.btn-label {
                display: none;
            }
            .toolbar .actions button {
                padding: 6px 12px;
                font-size: 15px;
            }
            .editor-panel .tabs .tab .lang-label {
                display: none;
            }
            .editor-panel .tabs .tab {
                padding: 8px 12px;
            }
            .statusbar {
                font-size: 11px;
                padding: 4px 12px;
            }
        }

        /* ===== 加载占位 ===== */
        .loading-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: #6a6a8a;
            font-size: 15px;
            letter-spacing: 0.5px;
            flex-direction: column;
            gap: 12px;
        }
        .loading-placeholder .spinner {
            width: 32px;
            height: 32px;
            border: 3px solid rgba(108, 92, 231, 0.15);
            border-top-color: #6c5ce7;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
        body.light-theme .loading-placeholder {
            color: #8a8aaa;
        }
    </style>
</head>
<body>

    <!-- ===== 顶部工具栏 ===== -->
    <header class="toolbar">
        <div class="brand">
            <span class="logo">✧</span>
            <span>CodeStudio</span>
            <span class="badge">免部署</span>
        </div>
        <div class="actions">
            <button class="primary" id="runBtn" title="刷新预览 (Ctrl+Enter)">
                <span>▶</span>
                <span class="btn-label">运行</span>
            </button>
            <button id="exportBtn" title="导出为 HTML 文件">
                <span>⬇</span>
                <span class="btn-label">导出</span>
            </button>
            <button id="clearBtn" title="清空所有代码">
                <span>✕</span>
                <span class="btn-label">清空</span>
            </button>
            <button class="theme-toggle" id="themeToggle" title="切换主题">
                <span id="themeIcon">🌙</span>
            </button>
        </div>
    </header>

    <!-- ===== 主体 ===== -->
    <div class="main">
        <!-- 编辑器面板 -->
        <div class="editor-panel">
            <div class="tabs" id="tabContainer">
                <div class="tab active" data-lang="html">
                    <span class="icon">⟨⟩</span>HTML
                    <span class="lang-label">.html</span>
                </div>
                <div class="tab" data-lang="css">
                    <span class="icon">🎨</span>CSS
                    <span class="lang-label">.css</span>
                </div>
                <div class="tab" data-lang="javascript">
                    <span class="icon">⚡</span>JavaScript
                    <span class="lang-label">.js</span>
                </div>
            </div>
            <div id="editor-container">
                <div class="loading-placeholder" id="loadingPlaceholder">
                    <div class="spinner"></div>
                    <span>加载编辑器...</span>
                </div>
            </div>
        </div>

        <!-- 预览面板 -->
        <div class="preview-panel">
            <div class="preview-header">
                <div class="preview-title">
                    <span class="dot" id="previewDot"></span>
                    <span>实时预览</span>
                </div>
                <div class="preview-actions">
                    <button id="refreshPreviewBtn" title="刷新预览">⟳</button>
                    <button id="openPreviewBtn" title="在新窗口打开">↗</button>
                </div>
            </div>
            <iframe id="preview-frame" sandbox="allow-scripts allow-modals allow-same-origin"></iframe>
        </div>
    </div>

    <!-- ===== 底部状态栏 ===== -->
    <div class="statusbar">
        <div class="status-item">
            <span id="statusLang">HTML</span>
            <span class="sep">|</span>
            <span id="statusCursor">行 1, 列 1</span>
        </div>
        <div class="status-item">
            <span id="statusChars">字符: 0</span>
            <span class="sep">|</span>
            <span id="statusLines">行数: 1</span>
        </div>
        <div class="status-item">
            <span id="statusTheme">暗色</span>
        </div>
    </div>

    <script>
        // ================================================================
        //  1. 配置 & 状态
        // ================================================================
        const STATE = {
            currentTab: 'html',
            contents: {
                html: '',
                css: '',
                javascript: ''
            },
            theme: 'dark', // 'dark' | 'light'
            editor: null,
            isReady: false
        };

        // ================================================================
        //  2. 示例代码 (首次打开时展示)
        // ================================================================
        const DEFAULT_CODE = {
            html: `<!-- 欢迎使用 CodeStudio ✧ -->
        <div class="container">
          <h1>✨ 你好，世界！</h1>
          <p>这是一个 <strong>免部署</strong> 的在线代码编辑器。</p>
          <p>编辑左侧代码，右侧实时预览。</p>
          <button id="btn">点我试试</button>
          <div id="output" class="output"></div>
        </div>`,

            css: `/* 样式表 — 让页面更生动 */
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        body {
          font-family: 'Segoe UI', system-ui, sans-serif;
          background: linear-gradient(145deg, #f5f3ff 0%, #ede9fe 100%);
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 20px;
        }
        .container {
          background: rgba(255,255,255,0.85);
          backdrop-filter: blur(12px);
          padding: 40px 48px;
          border-radius: 28px;
          box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
          max-width: 520px;
          width: 100%;
          text-align: center;
          border: 1px solid rgba(255,255,255,0.3);
          transition: all 0.3s;
        }
        .container:hover {
          transform: translateY(-2px);
          box-shadow: 0 30px 60px -12px rgba(108,92,231,0.30);
        }
        h1 {
          font-size: 28px;
          background: linear-gradient(135deg, #6c5ce7, #a78bfa);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
          margin-bottom: 12px;
        }
        p {
          color: #4b4b6a;
          line-height: 1.7;
          margin-bottom: 8px;
          font-size: 15px;
        }
        button {
          background: #6c5ce7;
          color: #fff;
          border: none;
          padding: 10px 28px;
          border-radius: 40px;
          font-size: 16px;
          font-weight: 600;
          cursor: pointer;
          transition: all 0.25s;
          margin-top: 16px;
          box-shadow: 0 4px 14px rgba(108,92,231,0.35);
        }
        button:hover {
          transform: scale(1.04);
          box-shadow: 0 8px 24px rgba(108,92,231,0.45);
        }
        button:active {
          transform: scale(0.96);
        }
        .output {
          margin-top: 18px;
          padding: 14px;
          border-radius: 14px;
          background: rgba(108,92,231,0.06);
          color: #4b4b6a;
          font-size: 14px;
          min-height: 40px;
          transition: all 0.3s;
          border: 1px dashed rgba(108,92,231,0.15);
        }
        .output.active {
          background: rgba(108,92,231,0.12);
          border-color: #6c5ce7;
        }`,

            javascript: `// JavaScript — 添加交互逻辑
        console.log('🚀 CodeStudio 已启动！');

        const btn = document.getElementById('btn');
        const output = document.getElementById('output');

        let count = 0;

        btn.addEventListener('click', function() {
          count++;
          const emojis = ['✨', '🌟', '🎉', '💫', '🔥', '⚡'];
          const emoji = emojis[count % emojis.length];
          const msg = \`\${emoji} 点击了 \${count} 次\`;
          output.textContent = msg;
          output.classList.add('active');

          // 额外彩蛋：改变按钮文字
          if (count === 5) {
            btn.textContent = '🌟 继续！';
          } else if (count === 10) {
            btn.textContent = '🚀 太棒了！';
          } else if (count === 15) {
            btn.textContent = '🏆 完美！';
          }

          console.log(\`点击次数: \${count}\`);
        });

        // 页面加载完成后自动触发一次
        document.addEventListener('DOMContentLoaded', function() {
          output.textContent = '👋 点击按钮开始互动！';
          output.classList.add('active');
        });`
        };

        // ================================================================
        //  3. 初始化 Ace Editor
        // ================================================================
        function initEditor() {
            const container = document.getElementById('editor-container');
            const placeholder = document.getElementById('loadingPlaceholder');

            try {
                const editor = ace.edit(container);
                editor.setTheme('ace/theme/monokai');
                editor.session.setMode('ace/mode/html');
                editor.setFontSize(14);
                editor.setShowPrintMargin(false);
                editor.setOptions({
                    enableBasicAutocompletion: true,
                    enableLiveAutocompletion: true,
                    enableSnippets: true,
                    tabSize: 2,
                    wrap: true,
                    showLineNumbers: true,
                    highlightActiveLine: true,
                    highlightGutterLine: true,
                });

                // 初始内容
                const initial = DEFAULT_CODE.html;
                editor.setValue(initial, -1);
                STATE.contents.html = initial;

                // 事件：内容变化时更新状态 & 自动预览
                editor.session.on('change', function() {
                    const val = editor.getValue();
                    STATE.contents[STATE.currentTab] = val;
                    updateStatus();
                    // 防抖自动预览
                    clearTimeout(window._previewTimer);
                    window._previewTimer = setTimeout(updatePreview, 400);
                });

                // 光标位置变化
                editor.session.selection.on('changeCursor', function() {
                    updateStatus();
                });

                STATE.editor = editor;
                STATE.isReady = true;

                // 移除加载占位
                placeholder.style.display = 'none';

                // 更新状态栏
                updateStatus();

                // 首次预览
                setTimeout(updatePreview, 300);

                return editor;
            } catch (e) {
                console.error('Ace 初始化失败:', e);
                placeholder.innerHTML = `
              <span style="color:#f87171;font-size:18px;">⚠️</span>
              <span>编辑器加载失败，请检查网络后刷新页面。</span>
            `;
                return null;
            }
        }

        // ================================================================
        //  4. 标签切换
        // ================================================================
        function switchTab(lang) {
            if (!STATE.editor || !STATE.isReady) return;
            if (lang === STATE.currentTab) return;

            // 保存当前内容
            STATE.contents[STATE.currentTab] = STATE.editor.getValue();

            // 更新标签 UI
            document.querySelectorAll('.tab').forEach(el => {
                el.classList.toggle('active', el.dataset.lang === lang);
            });

            // 切换编辑器模式 & 内容
            const modeMap = {
                html: 'ace/mode/html',
                css: 'ace/mode/css',
                javascript: 'ace/mode/javascript'
            };
            STATE.editor.session.setMode(modeMap[lang]);
            STATE.editor.setValue(STATE.contents[lang] || '', -1);
            STATE.editor.clearSelection();
            STATE.currentTab = lang;

            // 更新状态栏
            updateStatus();
        }

        // ================================================================
        //  5. 预览更新
        // ================================================================
        function updatePreview() {
            const html = STATE.contents.html || '';
            const css = STATE.contents.css || '';
            const js = STATE.contents.javascript || '';

            // 构建完整 HTML 文档
            const doc = `
        <!DOCTYPE html>
        <html lang="zh-CN">
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>预览</title>
          <style>${css}</style>
        </head>
        <body>
          ${html}
          <script>${js}<\/script>
        </body>
        </html>
        `;

            const iframe = document.getElementById('preview-frame');
            const dot = document.getElementById('previewDot');

            try {
                iframe.srcdoc = doc;
                dot.className = 'dot';
                // 如果有错误，会在 iframe 加载后检测，但 srcdoc 无法直接捕获错误，保持绿色表示尝试
            } catch (e) {
                dot.className = 'dot error';
                console.warn('预览更新出错:', e);
            }
        }

        // ================================================================
        //  6. 状态栏更新
        // ================================================================
        function updateStatus() {
            if (!STATE.editor) return;
            const session = STATE.editor.session;
            const cursor = STATE.editor.getCursorPosition();
            const langMap = {
                html: 'HTML',
                css: 'CSS',
                javascript: 'JavaScript'
            };
            document.getElementById('statusLang').textContent = langMap[STATE.currentTab] || 'HTML';
            document.getElementById('statusCursor').textContent = `行 ${cursor.row + 1}, 列 ${cursor.column + 1}`;
            const val = STATE.editor.getValue();
            document.getElementById('statusChars').textContent = `字符: ${val.length}`;
            const lines = val.split('\n').length;
            document.getElementById('statusLines').textContent = `行数: ${lines}`;
        }

        // ================================================================
        //  7. 主题切换
        // ================================================================
        function toggleTheme() {
            const isDark = STATE.theme === 'dark';
            const newTheme = isDark ? 'light' : 'dark';
            STATE.theme = newTheme;

            // 切换 body class
            document.body.classList.toggle('light-theme', newTheme === 'light');

            // 切换 Ace 主题
            if (STATE.editor) {
                STATE.editor.setTheme(newTheme === 'dark' ? 'ace/theme/monokai' : 'ace/theme/github');
            }

            // 更新图标 & 状态栏
            document.getElementById('themeIcon').textContent = newTheme === 'dark' ? '🌙' : '☀️';
            document.getElementById('statusTheme').textContent = newTheme === 'dark' ? '暗色' : '亮色';

            // 预览边框适配
            const frame = document.getElementById('preview-frame');
            frame.style.background = newTheme === 'dark' ? '#1a1a2e' : '#ffffff';
        }

        // ================================================================
        //  8. 导出功能
        // ================================================================
        function exportHTML() {
            const html = STATE.contents.html || '';
            const css = STATE.contents.css || '';
            const js = STATE.contents.javascript || '';

            const doc = `<!DOCTYPE html>
        <html lang="zh-CN">
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>导出的页面</title>
          <style>${css}</style>
        </head>
        <body>
          ${html}
          <script>${js}<\/script>
        </body>
        </html>`;

            const blob = new Blob([doc], { type: 'text/html;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `code-studio-export-${Date.now()}.html`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // ================================================================
        //  9. 清空功能
        // ================================================================
        function clearAll() {
            if (!confirm('确定要清空所有代码吗？')) return;
            STATE.contents = { html: '', css: '', javascript: '' };
            if (STATE.editor) {
                STATE.editor.setValue('', -1);
            }
            updatePreview();
            updateStatus();
        }

        // ================================================================
        //  10. 键盘快捷键
        // ================================================================
        function handleKeyboard(e) {
            // Ctrl+Enter / Cmd+Enter => 运行
            if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                e.preventDefault();
                updatePreview();
                // 闪烁一下状态点
                const dot = document.getElementById('previewDot');
                dot.style.transform = 'scale(1.3)';
                setTimeout(() => { dot.style.transform = 'scale(1)'; }, 200);
            }
            // Ctrl+S / Cmd+S => 导出
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                exportHTML();
            }
        }

        // ================================================================
        //  11. 新窗口打开预览
        // ================================================================
        function openPreviewInNewWindow() {
            const html = STATE.contents.html || '';
            const css = STATE.contents.css || '';
            const js = STATE.contents.javascript || '';
            const doc = `<!DOCTYPE html>
        <html lang="zh-CN">
        <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>预览 - CodeStudio</title>
          <style>${css}</style>
        </head>
        <body>
          ${html}
          <script>${js}<\/script>
        </body>
        </html>`;
            const win = window.open('', '_blank');
            if (win) {
                win.document.write(doc);
                win.document.close();
            } else {
                alert('请允许弹出窗口以预览。');
            }
        }

        // ================================================================
        //  12. 启动
        // ================================================================
        document.addEventListener('DOMContentLoaded', function() {
            // 初始化编辑器
            const editor = initEditor();
            if (!editor) return;

            // ---- 事件绑定 ----

            // 标签切换
            document.querySelectorAll('.tab').forEach(el => {
                el.addEventListener('click', function() {
                    switchTab(this.dataset.lang);
                });
            });

            // 运行按钮
            document.getElementById('runBtn').addEventListener('click', function() {
                updatePreview();
                const dot = document.getElementById('previewDot');
                dot.style.transform = 'scale(1.3)';
                setTimeout(() => { dot.style.transform = 'scale(1)'; }, 200);
            });

            // 导出按钮
            document.getElementById('exportBtn').addEventListener('click', exportHTML);

            // 清空按钮
            document.getElementById('clearBtn').addEventListener('click', clearAll);

            // 主题切换
            document.getElementById('themeToggle').addEventListener('click', toggleTheme);

            // 刷新预览按钮
            document.getElementById('refreshPreviewBtn').addEventListener('click', updatePreview);

            // 新窗口打开
            document.getElementById('openPreviewBtn').addEventListener('click', openPreviewInNewWindow);

            // 键盘快捷键
            document.addEventListener('keydown', handleKeyboard);

            // 窗口调整大小时，让编辑器 resize
            let resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (STATE.editor) STATE.editor.resize();
                }, 150);
            });

            // 点击预览刷新时，更新状态点
            document.getElementById('preview-frame').addEventListener('load', function() {
                // 尝试检测 iframe 内容是否有错误（简单方式）
                // 由于跨域限制，无法直接检测，保持绿色即可
            });

            // 初始主题状态
            document.getElementById('statusTheme').textContent = '暗色';
            document.getElementById('themeIcon').textContent = '🌙';

            console.log('✨ CodeStudio 已就绪！');
            console.log('📖 快捷键: Ctrl+Enter 预览 | Ctrl+S 导出');
        });
    </script>
</body>
</html>